# SyncSpace Environment Variables (Template)
# Do NOT commit the actual .env file to Git.

# --- Backend Configuration ---
PORT=3001
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Authentication (Make this a long random string in production)
JWT_SECRET=

# Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WebRTC (Optional TURN server)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Frontend Configuration ---
VITE_API_URL=
VITE_SOCKET_URL=