{
  "rewrites": [
    {
      "source": "/api/:type(auth|workspaces|channels|messages|upload|health)/:path*",
      "destination": "https://codealpha-real-time-communication-and.onrender.com/api/:type/:path*"
    },
    {
      "source": "/api/:type(auth|workspaces|channels|messages|upload|health)",
      "destination": "https://codealpha-real-time-communication-and.onrender.com/api/:type"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://codealpha-real-time-communication-and.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
